generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------
// Auth
// ----------------------------------------------------------------------

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         UserRole  @default(STAFF)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  auditLogs AuditLog[]

  @@map("users")
}

// ----------------------------------------------------------------------
// Catalog
// ----------------------------------------------------------------------

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  products Product[]

  @@map("categories")
}

enum ProductUnit {
  kg
  piece
  pcs
  sack
  crate
  litre
  bundle
}

enum EntityStatus {
  Active
  Inactive
}

model Product {
  id         String       @id // canonical prefixed id, e.g. "PRD-001"
  name       String
  categoryId String
  unit       ProductUnit
  basePrice  Int          @default(0) // landed unit cost; auto-updated from latest FRESH stock entry
  listPrice  Int          @default(0) // BP + tax% + profit% + others% — informational
  tradePrice Int          @default(0) // LP + tax% + profit% + others% — the price actually charged
  mrp        Int          @default(0) // TP + tax% + profit% + others% — informational/compliance only
  stock      Int          @default(0)
  status     EntityStatus @default(Active)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?

  // "Default recipe" — last-used percentages, nullable, prefill only, not authoritative.
  listTaxPercent     Int?
  listProfitPercent  Int?
  listOthersPercent  Int?
  tradeTaxPercent    Int?
  tradeProfitPercent Int?
  tradeOthersPercent Int?
  mrpTaxPercent      Int?
  mrpProfitPercent   Int?
  mrpOthersPercent   Int?

  category               Category                @relation(fields: [categoryId], references: [id])
  stockEntries           StockEntry[]
  distributionLines      DistributionLine[]
  saleItems              SaleItem[]
  invoiceItems           InvoiceItem[]
  stockAdjustments       StockAdjustment[]
  purchaseLines          PurchaseLine[]
  distributionOrderLines DistributionOrderLine[]

  @@index([name])
  @@index([categoryId])
  @@map("products")
}

// ----------------------------------------------------------------------
// Vans
// ----------------------------------------------------------------------

model Van {
  id        String    @id // "V1"
  vanName   String
  driver    String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  distributions    Distribution[]
  sales            Sale[]
  invoices         Invoice[]
  expenses         Expense[]
  stockAdjustments StockAdjustment[]

  @@map("vans")
}

// ----------------------------------------------------------------------
// Customers — restaurants/shops/direct buyers billed outside the van round.
// ----------------------------------------------------------------------

enum CustomerType {
  RESTAURANT
  SHOP
  DIRECT
  OTHER
}

model Customer {
  id        String       @id // "CUS-001"
  name      String
  type      CustomerType
  phone     String?
  address   String?
  status    EntityStatus @default(Active)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  distributionOrders DistributionOrder[]
  sales              Sale[]
  invoices           Invoice[]

  @@index([name])
  @@index([type])
  @@map("customers")
}

// ----------------------------------------------------------------------
// Stock Entries
// ----------------------------------------------------------------------

// Condition of a lot at the time it entered the warehouse.
// FRESH = default, full price. AGING = older stock to push first. DAMAGED =
// reduced-price salvage. CUSTOM = anything else (notes carry the meaning).
// FIFO groups by condition so damaged and fresh of the same product never mix.
enum StockCondition {
  FRESH
  AGING
  DAMAGED
  CUSTOM
}

model StockEntry {
  id                String         @id // "STK-992"
  date              DateTime       @db.Date
  productId         String
  batchId           String? // optional: physical batch this entry belongs to
  quantity          Int
  remainingQuantity Int // FIFO lot balance; decremented by distribution allocate + warehouse adjustment
  expiryDate        DateTime?      @db.Date
  basePrice         Int // this lot's real landed cost; always known at intake, never a fallback
  listPrice         Int? // per-lot override; when null, downstream falls back to Product.listPrice
  tradePrice        Int? // per-lot override; when null, downstream falls back to Product.tradePrice
  mrp               Int? // per-lot override; when null, downstream falls back to Product.mrp
  condition         StockCondition @default(FRESH)
  source            String
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  // Captured buildup inputs for this lot (nullable — not always known, e.g. salvaged/damaged lots).
  listTaxPercent     Int?
  listProfitPercent  Int?
  listOthersPercent  Int?
  tradeTaxPercent    Int?
  tradeProfitPercent Int?
  tradeOthersPercent Int?
  mrpTaxPercent      Int?
  mrpProfitPercent   Int?
  mrpOthersPercent   Int?

  product     Product              @relation(fields: [productId], references: [id])
  batch       StockBatch?          @relation(fields: [batchId], references: [id])
  allocations StockLotAllocation[]

  @@index([productId])
  @@index([date])
  @@index([batchId])
  @@index([productId, remainingQuantity])
  @@index([productId, condition, remainingQuantity])
  @@map("stock_entries")
}

// ----------------------------------------------------------------------
// Stock Batches — a physical receiving group that holds one or more
// StockEntry lines (possibly across different products). Created
// directly via the batches endpoint, or auto-created by a Purchase.
// ----------------------------------------------------------------------

model StockBatch {
  id        String    @id // "BAT-001"
  date      DateTime  @db.Date
  source    String // supplier or origin shared across all lines
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  entries           StockEntry[]
  purchases         Purchase[]
  distributionLines DistributionLine[]

  @@index([date])
  @@map("stock_batches")
}

// ----------------------------------------------------------------------
// Stock Lot Allocations (lot-level FIFO ledger)
// ----------------------------------------------------------------------

enum StockLotConsumerType {
  DISTRIBUTION_LINE
  SALE_ITEM
  STOCK_ADJUSTMENT
}

// One row = "quantity taken from stockEntryId (FIFO source) by consumerType/consumerId".
// - parentAllocationId null: consumed directly from warehouse StockEntry.
// - parentAllocationId set : sub-consumed from a prior allocation (e.g. sale from a
//   distribution-line allocation sitting on a van). Parent's remainingQuantity
//   decrements when a child is created, returns to warehouse on reversal.
// remainingQuantity: only meaningful for DISTRIBUTION_LINE rows (van-side lot balance).
// unitCost: snapshot of StockEntry.buyingRate at consumption time (COGS basis).
model StockLotAllocation {
  id                 String               @id @default(uuid())
  stockEntryId       String
  parentAllocationId String?
  consumerType       StockLotConsumerType
  consumerId         String
  quantity           Int
  remainingQuantity  Int                  @default(0)
  unitCost           Int
  createdAt          DateTime             @default(now())

  stockEntry StockEntry           @relation(fields: [stockEntryId], references: [id])
  parent     StockLotAllocation?  @relation("SubAllocation", fields: [parentAllocationId], references: [id])
  children   StockLotAllocation[] @relation("SubAllocation")

  @@index([consumerType, consumerId])
  @@index([parentAllocationId])
  @@index([stockEntryId])
  @@map("stock_lot_allocations")
}

// ----------------------------------------------------------------------
// Stock Adjustments (damage / wastage / correction)
// ----------------------------------------------------------------------

enum StockAdjustmentReason {
  DAMAGE
  WASTAGE
  CORRECTION
}

enum StockLocation {
  WAREHOUSE
  VAN
}

model StockAdjustment {
  id        String                @id // "ADJ-001"
  date      DateTime              @db.Date
  productId String
  quantity  Int // positive; positive = decrease, negative = increase (CORRECTION only)
  reason    StockAdjustmentReason
  location  StockLocation
  vanId     String?
  notes     String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  deletedAt DateTime?

  product Product @relation(fields: [productId], references: [id])
  van     Van?    @relation(fields: [vanId], references: [id])

  @@index([productId])
  @@index([date])
  @@index([reason])
  @@map("stock_adjustments")
}

// ----------------------------------------------------------------------
// Distribution
// ----------------------------------------------------------------------

model Distribution {
  id        String    @id // "DST-001"
  vanId     String
  date      DateTime  @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  van   Van                @relation(fields: [vanId], references: [id])
  lines DistributionLine[]

  @@index([vanId, date])
  @@index([date])
  @@map("distributions")
}

model DistributionLine {
  id             String  @id @default(uuid())
  distributionId String
  productId      String
  batchId        String? // optional: constrain FIFO allocation to a specific batch
  allocated      Int
  returned       Int     @default(0) // normal return → goes back to warehouse stock
  damageReturned Int     @default(0) // damaged return → counted as loss/wastage

  distribution Distribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  batch        StockBatch?  @relation(fields: [batchId], references: [id])

  @@index([distributionId, productId])
  @@index([batchId])
  @@map("distribution_lines")
}

// ----------------------------------------------------------------------
// Distribution Orders — restaurant/shop issue → confirm flow. Unlike
// Distribution (above), creating an order does NOT move stock: no
// StockLotAllocation, no Product.stock change. Only /confirm allocates FIFO
// warehouse lots (straight to a SALE_ITEM, no DistributionLine hop) for the
// confirmed quantities and produces a Sale + Invoice. Deliberately a separate
// model from Distribution/DistributionLine — those already have an
// allocate-on-create lifecycle wired into the van workflow (updateLine
// returns/damage, salvageLine, Sale.finalize's allocateFromVan chain) and
// reusing them for this issue-first flow would give one model two
// incompatible lifecycles.
// ----------------------------------------------------------------------

enum DistributionOrderStatus {
  issued
  confirmed
  cancelled
}

model DistributionOrder {
  id          String                  @id // "DOR-001"
  customerId  String
  date        DateTime                @db.Date
  status      DistributionOrderStatus @default(issued)
  confirmedAt DateTime?
  saleId      String?                 @unique
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  deletedAt   DateTime?

  customer Customer                @relation(fields: [customerId], references: [id])
  sale     Sale?                   @relation(fields: [saleId], references: [id])
  lines    DistributionOrderLine[]

  @@index([customerId, date])
  @@index([date])
  @@index([status])
  @@map("distribution_orders")
}

model DistributionOrderLine {
  id                  String @id @default(uuid())
  distributionOrderId String
  productId           String
  requestedQty        Int
  confirmedQty        Int? // null until confirm; 0..requestedQty
  price               Int? // null until confirm

  distributionOrder DistributionOrder @relation(fields: [distributionOrderId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id])

  @@index([distributionOrderId, productId])
  @@map("distribution_order_lines")
}

// ----------------------------------------------------------------------
// Sales + Invoices
// ----------------------------------------------------------------------

enum InvoiceStatus {
  unpaid
  paid
}

enum SaleType {
  VAN
  DISTRIBUTION_CONFIRMATION
  DIRECT_CUSTOMER
}

model Sale {
  id         String    @id // "SAL-001"
  vanId      String?
  customerId String?
  type       SaleType  @default(VAN)
  date       DateTime  @db.Date
  total      Int
  invoiceId  String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  van               Van?               @relation(fields: [vanId], references: [id])
  customer          Customer?          @relation(fields: [customerId], references: [id])
  items             SaleItem[]
  invoice           Invoice?           @relation(fields: [invoiceId], references: [id])
  distributionOrder DistributionOrder?

  @@index([vanId, date])
  @@index([customerId, date])
  @@map("sales")
}

model SaleItem {
  id        String @id @default(uuid())
  saleId    String
  productId String
  price     Int
  qty       Int

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model Invoice {
  id         String        @id // "INV-1024"
  vanId      String?
  customerId String?
  date       DateTime      @db.Date
  total      Int
  status     InvoiceStatus @default(unpaid)
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  van      Van?          @relation(fields: [vanId], references: [id])
  customer Customer?     @relation(fields: [customerId], references: [id])
  items    InvoiceItem[]
  sale     Sale?

  @@index([status])
  @@index([date])
  @@map("invoices")
}

model InvoiceItem {
  id        String @id @default(uuid())
  invoiceId String
  productId String
  name      String
  price     Int
  qty       Int
  subtotal  Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("invoice_items")
}

// ----------------------------------------------------------------------
// Expenses
// ----------------------------------------------------------------------

enum ExpenseStatus {
  paid
  pending
}

model Expense {
  id          String        @id // "EXP-001"
  date        DateTime      @db.Date
  category    String // "Fuel" | "Van Rent" | "Labor Cost" | "Shipping Cost" | "Market Fees"
  amount      Int
  description String
  status      ExpenseStatus @default(pending)
  vanId       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  van Van? @relation(fields: [vanId], references: [id])

  @@index([date])
  @@index([category])
  @@index([status])
  @@map("expenses")
}

// ----------------------------------------------------------------------
// Activity feed
// ----------------------------------------------------------------------

enum TransactionType {
  sale
  expense
  stock
  purchase
  bank_deposit
  bank_withdrawal
}

model Transaction {
  id          String          @id @default(uuid())
  occurredAt  DateTime
  amount      Int
  type        TransactionType
  description String
  refTable    String?
  refId       String?

  @@index([occurredAt])
  @@index([type])
  @@map("transactions")
}

// ----------------------------------------------------------------------
// Purchase (cost calculation for buy/sell price)
// ----------------------------------------------------------------------

enum PurchaseStatus {
  draft
  confirmed
}

model Purchase {
  id            String         @id // "PUR-001"
  date          DateTime       @db.Date
  source        String // supplier / source name (shared across lines)
  notes         String?
  status        PurchaseStatus @default(confirmed)
  bankAccountId String? // optional: deducted from bank account
  batchId       String? // auto-created StockBatch this purchase fed into
  total         Int            @default(0) // sum of all line totals (basePrice*qty + costs)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  lines       PurchaseLine[]
  bankAccount BankAccount?   @relation(fields: [bankAccountId], references: [id])
  batch       StockBatch?    @relation(fields: [batchId], references: [id])

  @@index([date])
  @@index([batchId])
  @@map("purchases")
}

model PurchaseLine {
  id                String         @id @default(uuid())
  purchaseId        String
  productId         String
  quantity          Int
  basePrice         Int // base price per unit (BDT)
  transportCost     Int            @default(0)
  labourCost        Int            @default(0)
  otherCost         Int            @default(0)
  effectiveBuyPrice Int // (basePrice*qty + transport + labour + other) / qty
  sellPrice         Int            @default(0)
  profitPercent     Int?
  condition         StockCondition @default(FRESH)
  createdAt         DateTime       @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_lines")
}

// ----------------------------------------------------------------------
// Banking
// ----------------------------------------------------------------------

enum BankTransactionType {
  deposit
  withdrawal
}

model BankAccount {
  id            String    @id @default(uuid())
  bankName      String
  accountNumber String
  accountHolder String?
  balance       Int       @default(0) // current balance in BDT
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  transactions BankTransaction[]
  purchases    Purchase[]

  @@map("bank_accounts")
}

model BankTransaction {
  id            String              @id @default(uuid())
  bankAccountId String
  type          BankTransactionType
  amount        Int // positive integer (BDT)
  description   String?
  reference     String? // cheque no, transfer ref, etc.
  occurredAt    DateTime
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@index([bankAccountId])
  @@index([occurredAt])
  @@map("bank_transactions")
}

// ----------------------------------------------------------------------
// Audit log
// ----------------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
}

model AuditLog {
  id         String      @id @default(uuid())
  occurredAt DateTime    @default(now())
  userId     String?
  action     AuditAction
  entity     String
  entityId   String
  before     Json?
  after      Json?
  meta       Json?

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([occurredAt])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------
// Prefix-id sequence
// ----------------------------------------------------------------------

model IdSequence {
  prefix String @id
  next   Int    @default(1)
  width  Int    @default(3)

  @@map("id_sequences")
}
